APP_NAME=crime-analytics-backend
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Authoritative approved datasets (override if layout differs)
DATA_DIR=ml-engine/datasets

# Persistence backend: "csv" (transitional) or "postgres" (production)
DATA_BACKEND=csv

# PostgreSQL (required when DATA_BACKEND=postgres)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?search_path=public
# DATABASE_POOL_MIN=1
# DATABASE_POOL_MAX=10

# ------------------------------------------------------------------
# Supabase Auth / JWT verification
# ------------------------------------------------------------------

# Supabase project reference — auto-derived from DATABASE_URL if not set.
# SUPABASE_PROJECT_REF=your-project-ref

# JWT symmetric secret (HS256) — from Supabase Dashboard → Settings → API → JWT Secret.
# Required when SUPABASE_JWKS_URL is not set.
# SUPABASE_JWT_SECRET=your-jwt-secret

# JWKS endpoint for asymmetric verification — auto-derived from project ref.
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# JWT issuer claim — auto-derived from project ref.
# SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# JWT audience claim (optional — skip validation if empty).
# SUPABASE_JWT_AUDIENCE=your-project-ref

# JWKS cache TTL in seconds (default 900 = 15 minutes).
# JWKS_CACHE_TTL=900

# Authentication enforcement — set to "false" for local dev without Supabase.
# REQUIRE_AUTH=true

# ------------------------------------------------------------------
# Role-based access control (RBAC)
# ------------------------------------------------------------------

# Require permission checks on protected routes (default true).
# RBAC_ENABLED=true

# Least-privilege role granted to an authenticated identity with no
# recognized role claim. Revisit when the police role policy is approved.
# RBAC_DEFAULT_ROLE=FIELD_OFFICER

# Dotted JWT claim paths (checked in order) used to resolve the role.
# RBAC_ROLE_CLAIM_PATHS=["app_metadata.role","role"]
